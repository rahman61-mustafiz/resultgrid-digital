# Copy this file to .env.local for local development. Never commit real values.

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-public-key
# Server-only secret. Bypasses Row Level Security -- never expose to the client
# or commit a real value. Used only by trusted server-side admin operations
# (e.g. the email-recovery break-glass flow).
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Base URL this app is served from, used to build absolute links (e.g. in
# recovery emails). No trailing slash.
APP_URL=http://localhost:3000

# Owner account identity (see CLAUDE_CODE_BUILD_HANDOFF.md). Not a secret, but
# keep in sync with the Supabase Auth user created for the Owner.
OWNER_EMAIL=mustafiz@resultgriddigital.com
# Pre-verified recovery email used only by the break-glass TOTP-recovery flow.
RECOVERY_EMAIL=mustafiz@resultgriddigital.com

# Secret for scheduled jobs (vercel.json crons -> /api/cron/*). At least 32
# characters, e.g. `openssl rand -hex 32`. Vercel Cron sends it as
# `Authorization: Bearer <value>`. Unset = the cron routes refuse every call.
CRON_SECRET=
